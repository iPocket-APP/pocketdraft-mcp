{
  "name": "pocketdraft-mcp",
  "version": "4.1.0",
  "description": "Local MCP bridge for the PocketDraft browser editor",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pocketdraft-mcp": "dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "verify:package": "node scripts/verify-package.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "author": "iPocket",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iPocket-APP/pocketdraft-mcp.git"
  },
  "homepage": "https://github.com/iPocket-APP/pocketdraft-mcp#readme",
  "bugs": {
    "url": "https://github.com/iPocket-APP/pocketdraft-mcp/issues"
  },
  "keywords": [
    "mcp",
    "pocketdraft",
    "screenshots",
    "design",
    "model-context-protocol"
  ],
  "devDependencies": {
    "@types/node": "25.5.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vite": "8.2.2"
  },
  "license": "UNLICENSED"
}
